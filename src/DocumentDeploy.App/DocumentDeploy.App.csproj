<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>DocumentDeploy</AssemblyName>
    <RootNamespace>DocumentDeploy.App</RootNamespace>
    <!-- Must stay false: WPF's data-binding engine (BindingExpression.GetCulture, used by every
         binding, not just ones with an explicit StringFormat) needs real culture data to
         activate. With this true, .NET strips that out entirely and even a plain {Binding X}
         throws "Cannot find non-neutral culture related to 'en-US'" the moment a bound window
         is shown. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Lets this project build (not run) on a non-Windows machine, e.g. for local CI-style validation. Harmless on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocumentDeploy.Core\DocumentDeploy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

</Project>
