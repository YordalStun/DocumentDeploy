<UserControl x:Class="DocumentDeploy.App.Controls.ReturnDropZoneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootBorder" BorderThickness="1" BorderBrush="#D7DCE5" CornerRadius="8" Padding="12"
            Background="#FAFBFD" AllowDrop="True" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave">
        <StackPanel>
            <TextBlock x:Name="NameText" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="14"/>
            <TextBlock x:Name="StatusText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#66707F" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BrowseButton" Content="Browse for file..." Padding="10,5" Click="OnBrowseClick"/>
                <Button x:Name="UndoButton" Content="Undo" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="8,0,0,0" Visibility="Collapsed" Click="OnUndoClick"/>
                <Button x:Name="OpenSourceButton" Content="Open source folder" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="8,0,0,0" Visibility="Collapsed" Click="OnOpenSourceClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
