<Window x:Class="DocumentDeploy.App.Views.AgendaItemEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agenda item" Width="440" Height="740" WindowStartupLocation="CenterOwner">
    <ScrollViewer Padding="16">
        <StackPanel>
            <TextBlock Text="Title"/>
            <TextBox x:Name="TitleBox" Margin="0,2,0,10"/>

            <TextBlock Text="Date"/>
            <DatePicker x:Name="DatePicker" Margin="0,2,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel Width="180">
                    <TextBlock Text="Start (HH:mm)"/>
                    <TextBox x:Name="StartBox"/>
                </StackPanel>
                <StackPanel Width="180" Margin="20,0,0,0">
                    <TextBlock Text="End (HH:mm)"/>
                    <TextBox x:Name="EndBox"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Kind"/>
            <ComboBox x:Name="KindCombo" Margin="0,2,0,10"/>

            <TextBlock Text="Group / who it's with (optional)"/>
            <TextBox x:Name="GroupBox" Margin="0,2,0,10"/>

            <TextBlock Text="Notes (optional)"/>
            <TextBox x:Name="NotesBox" Margin="0,2,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>

            <TextBlock Text="Session template (optional)"/>
            <ComboBox x:Name="SessionTemplateCombo" Margin="0,2,0,10" DisplayMemberPath="Name" SelectionChanged="OnSessionTemplateChanged"/>

            <StackPanel x:Name="FieldValuesPanel" Margin="0,0,0,10"/>

            <TextBlock Text="Documents needed (click to toggle)"/>
            <ListBox x:Name="DocumentsListBox" Height="140" Margin="0,2,0,16" SelectionMode="Multiple" DisplayMemberPath="Name"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="Save" Padding="14,6" IsDefault="True" Click="OnSaveClick"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
