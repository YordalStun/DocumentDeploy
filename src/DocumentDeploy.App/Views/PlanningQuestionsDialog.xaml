<Window x:Class="DocumentDeploy.App.Views.PlanningQuestionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Planning questions" Width="460" Height="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="A few things to decide now, while you're planning - they'll show up alongside each lesson."/>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="ItemsPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Skip for now" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0" Click="OnSkipClick"/>
            <Button Content="Save answers" Padding="14,6" IsDefault="True" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
