<Window x:Class="DocumentDeploy.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocumentDeploy" Height="720" Width="460" MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Grid Background="#F4F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2B3D7A" Padding="20,16">
            <StackPanel>
                <TextBlock x:Name="DateText" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="TimeStatusText" Foreground="#C7CEE8" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="OutstandingBanner" Background="#FDECEA" BorderBrush="#F1A9A0" BorderThickness="1"
                        CornerRadius="10" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Outstanding" FontWeight="Bold" Foreground="#8A2E24" Margin="0,0,0,8"/>
                        <StackPanel x:Name="OutstandingPanel"/>
                    </StackPanel>
                </Border>

                <Border x:Name="WrapUpBanner" Background="#EAF1FB" BorderBrush="#B9D3F0" BorderThickness="1"
                        CornerRadius="10" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Wrap up" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <StackPanel x:Name="WrapUpPanel"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="RIGHT NOW" FontSize="11" FontWeight="Bold" Foreground="#8993A6"/>
                        <StackPanel x:Name="CurrentPanel" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="NextCard" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="COMING UP" FontSize="11" FontWeight="Bold" Foreground="#8993A6"/>
                        <StackPanel x:Name="NextPanel" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TODAY" FontSize="11" FontWeight="Bold" Foreground="#8993A6"/>
                        <StackPanel x:Name="TodayPanel" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E1E5EC" BorderThickness="0,1,0,0" Padding="10">
            <UniformGrid Rows="1" Columns="4">
                <Button Margin="4" Padding="4,8" MinHeight="44" Click="OnTimetableClick">
                    <TextBlock Text="Timetable" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button Margin="4" Padding="4,8" MinHeight="44" Click="OnTemplatesClick">
                    <TextBlock Text="Templates" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button Margin="4" Padding="4,8" MinHeight="44" Click="OnPlanWeekClick">
                    <TextBlock Text="Plan Week" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button Margin="4" Padding="4,8" MinHeight="44" Click="OnSettingsClick">
                    <TextBlock Text="Settings" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
