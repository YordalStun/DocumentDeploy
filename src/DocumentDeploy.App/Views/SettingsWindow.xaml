<Window x:Class="DocumentDeploy.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="440" Height="560" WindowStartupLocation="CenterOwner">
    <ScrollViewer Padding="20">
        <StackPanel>
            <TextBlock Text="Timing" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Morning brief time (HH:mm)"/>
            <TextBox x:Name="MorningBriefTimeBox" Margin="0,2,0,10"/>

            <TextBlock Text="Prep lead time - minutes before a slot to start reminding you"/>
            <TextBox x:Name="LeadTimeBox" Margin="0,2,0,10"/>

            <TextBlock Text="Weekly planning nudge day"/>
            <ComboBox x:Name="PlanningDayCombo" Margin="0,2,0,10"/>

            <TextBlock Text="Weekly planning nudge time (HH:mm)"/>
            <TextBox x:Name="PlanningTimeBox" Margin="0,2,0,10"/>

            <CheckBox x:Name="StartupCheckBox" Content="Launch automatically when Windows starts" Margin="0,10,0,20"/>

            <Separator Margin="0,0,0,20"/>

            <TextBlock Text="Backup / bulk edit" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Timetable" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                <Button Content="Export CSV..." Padding="10,5" Margin="0,0,8,0" Click="OnExportTimetableClick"/>
                <Button Content="Import CSV..." Padding="10,5" Click="OnImportTimetableClick"/>
            </StackPanel>

            <TextBlock Text="Document templates" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                <Button Content="Export CSV..." Padding="10,5" Margin="0,0,8,0" Click="OnExportTemplatesClick"/>
                <Button Content="Import CSV..." Padding="10,5" Click="OnImportTemplatesClick"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,20"/>

            <Button Content="Save and close" Padding="16,6" HorizontalAlignment="Right" Click="OnCloseClick"/>
        </StackPanel>
    </ScrollViewer>
</Window>
