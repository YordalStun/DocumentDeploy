<Window x:Class="DocumentDeploy.App.Views.TimetableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timetable" Width="680" Height="560" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Add slot" Padding="10,5" Margin="0,0,8,0" Click="OnAddClick"/>
            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,8,0" Click="OnEditClick"/>
            <Button Content="Duplicate" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,8,0" Click="OnDuplicateClick"/>
            <Button Content="Delete" Style="{StaticResource DangerButton}" Padding="10,5" Click="OnDeleteClick"/>
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="OnGridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="100"/>
                <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat={}{0:HH:mm}}" Width="70"/>
                <DataGridTextColumn Header="End" Binding="{Binding End, StringFormat={}{0:HH:mm}}" Width="70"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90"/>
                <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="100"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
