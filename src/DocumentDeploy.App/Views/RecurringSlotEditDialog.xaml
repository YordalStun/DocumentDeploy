<Window x:Class="DocumentDeploy.App.Views.RecurringSlotEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timetable slot" Width="420" Height="660" WindowStartupLocation="CenterOwner">
    <ScrollViewer Padding="16">
        <StackPanel>
            <TextBlock Text="Title"/>
            <TextBox x:Name="TitleBox" Margin="0,2,0,10"/>

            <TextBlock Text="Day"/>
            <ComboBox x:Name="DayCombo" Margin="0,2,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel Width="180">
                    <TextBlock Text="Start (HH:mm)"/>
                    <TextBox x:Name="StartBox"/>
                </StackPanel>
                <StackPanel Width="180" Margin="20,0,0,0">
                    <TextBlock Text="End (HH:mm)"/>
                    <TextBox x:Name="EndBox"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Kind"/>
            <ComboBox x:Name="KindCombo" Margin="0,2,0,10"/>

            <TextBlock Text="Group / class (optional)"/>
            <TextBox x:Name="GroupBox" Margin="0,2,0,10"/>

            <TextBlock Text="Default notes for every week (optional)"/>
            <TextBox x:Name="NotesBox" Margin="0,2,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

            <CheckBox x:Name="ActiveCheckBox" Content="Active - generate this into future weeks" Margin="0,0,0,10"/>

            <TextBlock Text="Session template (optional pattern, e.g. Phonics Lesson)"/>
            <ComboBox x:Name="SessionTemplateCombo" Margin="0,2,0,10" DisplayMemberPath="Name"/>

            <TextBlock Text="Documents needed for this slot (click to toggle)"/>
            <ListBox x:Name="DocumentsListBox" Height="140" Margin="0,2,0,16" SelectionMode="Multiple" DisplayMemberPath="Name"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="Save" Padding="14,6" IsDefault="True" Click="OnSaveClick"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
