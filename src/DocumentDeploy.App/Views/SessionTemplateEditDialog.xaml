<Window x:Class="DocumentDeploy.App.Views.SessionTemplateEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session template" Width="440" Height="660" WindowStartupLocation="CenterOwner">
    <ScrollViewer Padding="16">
        <StackPanel>
            <TextBlock Text="Name (e.g. Phonics Lesson)"/>
            <TextBox x:Name="NameBox" Margin="0,2,0,10"/>

            <TextBlock Text="Default notes applied every time this template is used (optional)"/>
            <TextBox x:Name="DefaultNotesBox" Margin="0,2,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>

            <TextBlock Text="Questions to ask each time" Margin="0,10,0,0"/>
            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Planning questions (e.g. &quot;Today's sound&quot;) are asked while you plan the week. Completion questions (e.g. &quot;How did it go&quot;) are asked once the session is over."/>
            <ListBox x:Name="FieldsListBox" Height="110" Margin="0,4,0,6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}  ·  {1}">
                                    <Binding Path="Label"/>
                                    <Binding Path="AskAt"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox x:Name="NewFieldBox" Width="170" Margin="0,0,8,0"/>
                <ComboBox x:Name="NewFieldTimingCombo" Width="110" Margin="0,0,8,0"/>
                <Button Content="Add" Padding="10,4" Margin="0,0,8,0" Click="OnAddFieldClick"/>
                <Button Content="Remove" Style="{StaticResource SecondaryButton}" Padding="10,4" Click="OnRemoveFieldClick"/>
            </StackPanel>

            <TextBlock Text="Documents this type of session usually needs"/>
            <ListBox x:Name="DocumentsListBox" Height="120" Margin="0,4,0,16" SelectionMode="Multiple" DisplayMemberPath="Name"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="Save" Padding="14,6" IsDefault="True" Click="OnSaveClick"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
