<Window x:Class="DocumentDeploy.App.Views.SessionTemplateEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session template" Width="440" Height="660" WindowStartupLocation="CenterOwner">
    <ScrollViewer Padding="16">
        <StackPanel>
            <TextBlock Text="Name (e.g. Phonics Lesson)"/>
            <TextBox x:Name="NameBox" Margin="0,2,0,10"/>

            <TextBlock Text="Default notes applied every time this template is used (optional)"/>
            <TextBox x:Name="DefaultNotesBox" Margin="0,2,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>

            <TextBlock Text="Questions to ask each time (e.g. &quot;Today's sound&quot;, &quot;Three words&quot;)" Margin="0,10,0,0"/>
            <ListBox x:Name="FieldsListBox" Height="110" Margin="0,4,0,6" DisplayMemberPath="Label"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox x:Name="NewFieldBox" Width="220" Margin="0,0,8,0"/>
                <Button Content="Add question" Padding="10,4" Margin="0,0,8,0" Click="OnAddFieldClick"/>
                <Button Content="Remove" Style="{StaticResource SecondaryButton}" Padding="10,4" Click="OnRemoveFieldClick"/>
            </StackPanel>

            <TextBlock Text="Documents this type of session usually needs"/>
            <ListBox x:Name="DocumentsListBox" Height="120" Margin="0,4,0,16" SelectionMode="Multiple" DisplayMemberPath="Name"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="Save" Padding="14,6" IsDefault="True" Click="OnSaveClick"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
