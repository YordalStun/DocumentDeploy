<Window x:Class="DocumentDeploy.App.Views.WeeklyPlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan the week" Width="740" Height="640" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="◀ Previous week" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,8,0" Click="OnPreviousWeekClick"/>
            <TextBlock x:Name="WeekLabel" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Margin="8,0"/>
            <Button Content="Next week ▶" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="8,0,0,0" Click="OnNextWeekClick"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Generate from timetable" Padding="10,5" Margin="0,0,8,0" Click="OnGenerateClick"/>
            <Button Content="Add one-off item" Padding="10,5" Margin="0,0,8,0" Click="OnAddClick"/>
            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,8,0" Click="OnEditClick"/>
            <Button Content="Delete" Style="{StaticResource DangerButton}" Padding="10,5" Margin="0,0,8,0" Click="OnDeleteClick"/>
            <Button Content="Answer planning questions" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="OnAnswerPlanningQuestionsClick"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#FDECEA" BorderBrush="#F1A9A0" BorderThickness="1" CornerRadius="6"
                Padding="10" Margin="0,0,0,10" x:Name="OutstandingBanner" Visibility="Collapsed">
            <TextBlock x:Name="OutstandingText" TextWrapping="Wrap" Foreground="#8A2E24"/>
        </Border>

        <Border Grid.Row="3" Background="#EEF1F7" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6"
                Padding="10" Margin="0,0,0,10" x:Name="RecapCard" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Last week's answers" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel x:Name="RecapPanel"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="Grid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="OnGridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:ddd d MMM}}" Width="120"/>
                <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat={}{0:HH:mm}}" Width="70"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90"/>
                <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
